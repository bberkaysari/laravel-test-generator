{
    "name": "bberkaysari/laravel-test-generator",
    "description": "Universal Laravel test generator without AI - Generate comprehensive tests automatically",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "testing",
        "phpunit",
        "pest",
        "test-generator",
        "automation",
        "code-generation"
    ],
    "authors": [
        {
            "name": "bberkaysari",
            "email": "bberkaysari0@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^4.17|^5.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/finder": "^6.0|^7.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Bberkaysari\\LaravelTestGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bberkaysari\\LaravelTestGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse src tests --level=8",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}